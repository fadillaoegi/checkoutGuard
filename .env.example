# Local development defaults. Never put credentials in the frontend.
DATABASE_URL=postgres://checkoutguard:checkoutguard_local@127.0.0.1:55433/checkoutguard?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Existing partner configuration is outside this repository.
# Default: .env.neatlogs.local in the repo, or ../.neatlogs-api.env.
# NEATLOGS_ENV_FILE=/absolute/path/to/private/neatlogs.env
# OpenAI-compatible model credentials; independent from telemetry access.
# Default: .env.model.local in the repo, or ../.apertus-api.env.
# MODEL_ENV_FILE=/absolute/path/to/private/model.env
# Optional separate rate configuration (also detects .env.pricing.local):
# MODEL_PRICING_ENV_FILE=/absolute/path/to/private/pricing.env
# Optional overrides for an OpenAI-compatible endpoint:
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_API_KEY=replace_locally
# MODEL_NAME=provider-model
# MODEL_PROVIDER=provider-name
# MODEL_BASE_URL / MODEL_API_KEY / MODEL_NAME form one complete profile.
# Setting any one disables inheritance from APERTUS_* credentials.
# Candidate profile setup: docs/PROVIDER-CANDIDATE.md
# Total request deadline, including response body: 10..60 seconds (default 45).
# MODEL_REQUEST_TIMEOUT_SECONDS=45
# Optional prices; omitted values mean unknown cost, not zero cost.
# Only apply these prices when the provider returns MODEL_PRICED_MODEL.
# MODEL_PRICED_MODEL=provider-model
# MODEL_PRICED_PROVIDER=provider-name
# MODEL_INPUT_USD_PER_MILLION=1.0
# MODEL_OUTPUT_USD_PER_MILLION=2.0
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
